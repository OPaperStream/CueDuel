; Engine configuration file.

config_version=5

[application]

config/name="Cue Duel"
config/description="8-ball pool against the computer or a friend."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0784, 0.0667, 0.0588, 1)
boot_splash/show_image=false

[autoload]

L="*res://scripts/i18n.gd"
Store="*res://scripts/store.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSans-SemiBold.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
